# ── Database (Neon PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Primary Super Admin Clearance ───────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_NAME=Workspace Administrator
# Optional: extra Super Admins (comma-separated). Super Admins can't be demoted/deleted
# and are the only ones who can grant or revoke the admin role.
# ADMIN_EMAILS=cofounder@yourdomain.com
# ADMIN_PASSWORD is only applied when the admin account is first created.
# Set to true for one deploy to force it back onto the account (account recovery).
# ADMIN_PASSWORD_RESET_ON_BOOT=false

# ── JWT Security & Cryptography ─────────────────────────────────────
# REQUIRED in production, or every restart logs all users out.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=production_ultra_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth 2.0 (Sign in with Google) ──────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults automatically to {BACKEND_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# ── Transactional Email Service (SMTP or Resend) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
# Optional Resend API key (if using Resend instead of SMTP)
# RESEND_API_KEY=re_123456789

# ── Domain URLs (CORS & OAuth Redirects) ────────────────────────────
FRONTEND_PROD_URL=https://agenticmarketer.vercel.app
BACKEND_PROD_URL=https://agenticmarketer-backend.onrender.com
# Optional: extra frontend origins allowed as Google-login redirect targets
# (e.g. a custom domain or a fixed preview URL). Comma-separated.
# FRONTEND_ALLOWED_ORIGINS=https://www.yourdomain.com

# ── AI Engine API Keys ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
EDEN_AI_API_KEY=your_eden_ai_api_key
