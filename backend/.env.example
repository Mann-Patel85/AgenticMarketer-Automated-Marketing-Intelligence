# ── Database (Neon PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Primary Super Admin Clearance (Mann Patel) ─────────────────────
ADMIN_EMAIL=mann@company.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Mann Patel

# ── JWT Security & Cryptography ─────────────────────────────────────
JWT_SECRET=production_ultra_secure_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth 2.0 (Sign in with Google) ──────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional override; defaults automatically to {BACKEND_URL}/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# ── Transactional Email Service (SMTP or Resend) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
# Optional Resend API key (if using Resend instead of SMTP)
# RESEND_API_KEY=re_123456789

# ── Domain URLs (CORS & OAuth Redirects) ────────────────────────────
FRONTEND_PROD_URL=https://agenticmarketer.vercel.app
BACKEND_PROD_URL=https://agenticmarketer-backend.onrender.com

# ── AI Engine API Keys ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
EDEN_AI_API_KEY=your_eden_ai_api_key
