# ==============================================================================
# AgenticMarketer: Automated Marketing Intelligence Environment Variables
# ==============================================================================

# Google Gemini API Key (multimodal text reasoning & visual prompts)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model Name for text and copywriting (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Model Name for AI image generation (e.g. gemini-3-pro-image)
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Cloudflare Workers AI (Primary Image Generation - FLUX.1 schnell)
# Get Account ID and API Token at: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Eden AI Universal AI (Fallback 1 Image Generation)
# Get a key at: https://www.edenai.co/
EDEN_AI_API_KEY=

# JWT Secret Key for Authentication (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Omnichannel Social Publishing Credentials
# 1. LinkedIn (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# 2. X / Twitter (https://developer.x.com/)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# 3. Meta (Facebook Page & Instagram) (https://developers.facebook.com/)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# 4. Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=test

# 5. Meta Threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
