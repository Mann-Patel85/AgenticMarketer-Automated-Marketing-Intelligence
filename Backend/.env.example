# ── Neon PostgreSQL Database Connection ──────────────────────────────
# Paste your Neon DB connection string here (SSL mode is required on Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Groq Cloud LPU AI (Primary High-Speed Text Engine) ───────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Cloudflare Workers AI (Primary Image Generation - FLUX.1 schnell) ─
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ── Authentication & Security ─────────────────────────────────────────
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_secure_random_256_bit_secret_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Production CORS / Frontend Origin ─────────────────────────────────
# URL of your Vercel deployment (without trailing slash)
FRONTEND_PROD_URL=https://your-agenticmarketer.vercel.app

# ── Optional Fallback AI Engines ──────────────────────────────────────
EDEN_AI_API_KEY=
